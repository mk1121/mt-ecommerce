[{"/media/oem/data/project/nodeJs/mt-commerce/frontend/src/App.jsx":"1","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/index.jsx":"2","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/store.jsx":"3","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/Home.jsx":"4","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/layout/Footer.jsx":"5","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/layout/Header.jsx":"6","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/product/ProductDetails.jsx":"7","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/cart/Shipping.jsx":"8","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/cart/Cart.jsx":"9","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/cart/OrderSuccess.jsx":"10","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/cart/Payment.jsx":"11","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/cart/ConfirmOrder.jsx":"12","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/order/ListOrders.jsx":"13","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/order/OrderDetails.jsx":"14","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/Register.jsx":"15","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/Profile.jsx":"16","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/UpdatePassword.jsx":"17","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/Login.jsx":"18","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/NewPassword.jsx":"19","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/ForgotPassword.jsx":"20","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/admin/ProductsList.jsx":"21","/media/oem/data/project/nodeJs/mt-commerce/frontend/src/components/user/UpdateProfile.jsx":"22","/media/oe